#!/bin/sh
set -eu

source_path=$0
while [ -L "$source_path" ]; do
	source_dir=$(CDPATH= cd -- "$(dirname -- "$source_path")" && pwd)
	link_target=$(readlink "$source_path")
	case "$link_target" in
		/*) source_path=$link_target ;;
		*) source_path=$source_dir/$link_target ;;
	esac
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$source_path")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
mkdir -p "$repo_root/.build"

if [ -n "${DOCK_GO:-}" ]; then
	go_bin=$DOCK_GO
elif command -v go >/dev/null 2>&1; then
	go_bin=$(command -v go)
elif [ -x /usr/local/go/bin/go ]; then
	go_bin=/usr/local/go/bin/go
else
	echo "Go was not found; install Go 1.27 or set DOCK_GO." >&2
	exit 127
fi

"$go_bin" -C "$repo_root" build -o "$repo_root/.build/dock" ./cmd/dock
exec "$repo_root/.build/dock" "$@"
